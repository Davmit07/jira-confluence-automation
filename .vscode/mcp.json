{
  "inputs": [
    {
      "type": "promptString",
      "id": "jira-url",
      "description": "Jira Server/Data Center base URL (HTTPS)",
      "default": "https://jiraeu.epam.com"
    },
    {
      "type": "promptString",
      "id": "jira-personal-token",
      "description": "Jira Server/Data Center personal access token",
      "password": true
    }
  ],
  "servers": {
    "echo-macos": {
      "command": "pwsh",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "./path/to/mcp-echo.ps1"]
    },
    "jira": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://jiraeu.epam.com/",
        "READ_ONLY_MODE": "true",
        "JIRA_EMAIL": "amit_dixit@epam.com",
        "JIRA_API_TOKEN": "${input:jira-personal-token}"
      }
    }
  }
}
