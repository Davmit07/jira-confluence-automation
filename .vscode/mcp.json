{
  "inputs": [
    {
      "type": "promptString",
      "id": "jira-username",
      "description": "Jira username or email"
    },
    {
      "type": "promptString",
      "id": "jira-api-token",
      "description": "Jira API token",
      "password": true
    }
  ],
  "servers": {
    "echo-macos": {
      "command": "pwsh",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "./path/to/mcp-echo.ps1"]
    },
    "jira": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://jiraeu.epam.com/",
        "JIRA_USERNAME": "${input:jira-username}",
        "JIRA_API_TOKEN": "${input:jira-api-token}",
        "READ_ONLY_MODE": "true"
      }
    }
  }
}
