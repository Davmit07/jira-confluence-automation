# Local only. The Jira MCP server reads ATLASSIAN_BASE_URL and JIRA_TOKEN
# (Server/Data Center personal access token) from the gitignored .env file.
ATLASSIAN_BASE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
JIRA_TOKEN=
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY
JIRA_BLOCKED_STATUSES=Blocked,Impeded
MANAGER_NAME=Engineering Manager